{
  "name": "repo-compass",
  "version": "1.0.3",
  "description": "Static code intelligence for AI-assisted development. Generates a dense CODEBASE.ctx from your source files — no API calls, pure local compute.",
  "type": "module",
  "bin": {
    "repo-compass": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "files": [
    "dist",
    "scripts",
    ".claude",
    "SKILL.md"
  ],
  "keywords": [
    "cli",
    "documentation",
    "open-source",
    "developer-tools",
    "claude",
    "ai",
    "codebase-context",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pietrotommasini2022/repo-compass.git"
  },
  "homepage": "https://github.com/pietrotommasini2022/repo-compass#readme",
  "bugs": {
    "url": "https://github.com/pietrotommasini2022/repo-compass/issues"
  },
  "author": "Pietro Tommasini",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "commander": "14.0.3",
    "fast-glob": "3.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "4.21.0"
  }
}